# Edit the config.toml in the install folder (copied from support/config.toml.in on first start); support/ is replaced on upgrade.
# Host declarations in ssh_config define connection order. OpenSSH manages host trust.

[proxy]
bind = "127.0.0.1"
socks_port = 1081
http_port = 8181

# Shared SSH behavior; file paths are relative to this config.toml.
[ssh]
executable = "ssh"
config_file = "ssh_config"
connect_timeout_seconds = 10
connection_attempts = 1
server_alive_interval_seconds = 15
server_alive_count_max = 3
ready_timeout_seconds = 25
retry_delay_seconds = 5

[health]
targets = ["example.com:443", "www.microsoft.com:443"]
failover_on_probe_failure = false
interval_seconds = 30
timeout_seconds = 8
failures_before_failover = 3

# Each process run writes one continuous file in logs/; errors append to it.
# Size limit per log file in MB (1..1024); at the limit the older half is removed and marked.
# Keep this many recent files per kind (tray / proxy), including the current run.
[logging]
max_log_files = 10
max_size_mb = 10
